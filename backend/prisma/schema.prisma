generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int         @id @default(autoincrement())
  username  String
  email     String      @unique
  password  String
  createdAt DateTime    @default(now())
  role      Role        @default(BUYER)
  alamat    Alamat[]
  keranjang Keranjang[]
  products  Produk[]
  transaksi Transaksi[]
  toko Toko?
}

model Kategori_Produk {
  id_kategori   String   @id @default(uuid())
  nama_kategori String
  products      Produk[]
}

model Produk {
  id_produk        String             @id @default(uuid())
  id_user_seller   Int
  id_kategori      String
  nama_produk      String
  deskripsi        String
  harga            Int
  stok             Int
  status_produk    String
  created_at       DateTime           @default(now())
  foto_produk      String?
  konten_deskripsi String?
  catatan_penjual  String?
  foto_produk_list String[]           @default([])
  keranjang        Keranjang[]
  kategori         Kategori_Produk    @relation(fields: [id_kategori], references: [id_kategori])
  seller           User               @relation(fields: [id_user_seller], references: [id])

  detailTransaksis Detail_Transaksi[]
}

model Keranjang {
  id_keranjang String   @id @default(uuid())
  id_user      Int
  id_produk    String
  created_at   DateTime @default(now())
  produk       Produk   @relation(fields: [id_produk], references: [id_produk], onDelete: Cascade)
  user         User     @relation(fields: [id_user], references: [id], onDelete: Cascade)

  @@unique([id_user, id_produk])
  @@unique([id_user, id_produk], map: "Wishlist_id_user_id_produk_key")
}

model Alamat {
  id_alamat      String      @id @default(uuid())
  id_user        Int
  nama_penerima  String
  nomor_hp       String
  alamat_lengkap String
  user           User        @relation(fields: [id_user], references: [id], onDelete: Cascade)
  transaksi      Transaksi[]
}

model Jasa_Kirim {
  id_jasa          String      @id @default(uuid())
  nama_jasa        String
  harga_pengiriman Int
  estimasi_waktu   String
  transaksi        Transaksi[]
}

model Metode_Pembayaran {
  id_metode   String      @id @default(uuid())
  nama_metode String
  kode_metode String
  transaksi   Transaksi[]
}

model Transaksi {
  id_transaksi         String   @id @default(uuid())
  id_user              Int
  id_alamat            String
  id_jasa_kirim        String
  id_metode_pembayaran String

  total_harga          Int      @default(0)
  status_transaksi     String
  tanggal_transaksi    DateTime @default(now())

  pembayaran           Pembayaran?
  tracking_logs        TrackingLog[]

  alamat               Alamat            @relation(fields: [id_alamat], references: [id_alamat])
  jasa_kirim           Jasa_Kirim        @relation(fields: [id_jasa_kirim], references: [id_jasa])
  metode_pembayaran    Metode_Pembayaran @relation(fields: [id_metode_pembayaran], references: [id_metode])
  user                 User              @relation(fields: [id_user], references: [id], onDelete: Cascade)

  detail_transaksi     Detail_Transaksi[]
}

model Detail_Transaksi {
  id_detail    String @id @default(uuid())
  id_transaksi String
  id_produk    String
  kuantitas    Int
  harga_satuan Int
  subtotal     Int

  transaksi Transaksi @relation(fields: [id_transaksi], references: [id_transaksi], onDelete: Cascade)
  produk    Produk    @relation(fields: [id_produk], references: [id_produk])

  @@index([id_transaksi])
  @@index([id_produk])
}

model Pembayaran {
  id_pembayaran      String    @id @default(uuid())
  id_transaksi       String    @unique
  status_pembayaran  String
  tanggal_pembayaran DateTime  @default(now())
  transaksi          Transaksi @relation(fields: [id_transaksi], references: [id_transaksi], onDelete: Cascade)
}

model TrackingLog {
  id_log       String    @id @default(uuid())
  id_transaksi String
  status       String
  waktu        DateTime  @default(now())
  transaksi    Transaksi @relation(fields: [id_transaksi], references: [id_transaksi], onDelete: Cascade)
}

model Toko {
  id_toko      String   @id @default(uuid())
  id_user      Int      @unique
  nama_toko    String
  email_bisnis String?
  alamat_toko  String?
  created_at   DateTime @default(now())

  user         User     @relation(fields: [id_user], references: [id], onDelete: Cascade)
}

enum Role {
  BUYER
  SELLER
  ADMIN
  GUEST
}
